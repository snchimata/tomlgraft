{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "17px",
    "primaryColor": "#f7f8fa",
    "primaryTextColor": "#24292f",
    "primaryBorderColor": "#8c959f",
    "lineColor": "#57606a",
